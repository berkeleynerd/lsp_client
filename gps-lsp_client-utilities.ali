V "GNAT Lib v15"
A -gnatA
A -gnat2022
A -mmacosx-version-min=26.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

RN
RV NO_EXCEPTION_HANDLERS
RV NO_EXCEPTIONS
RV NO_IMPLICIT_CONDITIONALS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U gps.lsp_client.utilities%b  gps-lsp_client-utilities.adb  558e5b65 NE OO PK IU
Z ada.exceptions%s	a-except.adb		a-except.ali
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W gps.lsp_client%s	gps-lsp_client.ads	gps-lsp_client.ali
W lsp%s			lsp.ads			lsp.ali
W lsp.types%s		lsp-types.adb		lsp-types.ali
