V "GNAT Lib v15"
A -gnatA
A -gnat2022
A -mmacosx-version-min=26.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

RN
RV NO_ACCESS_SUBPROGRAMS
RV NO_DISPATCH
RV NO_DISPATCHING_CALLS
RV NO_EXCEPTION_HANDLERS
RV NO_EXCEPTIONS
RV NO_IMPLICIT_CONDITIONALS
RV NO_NESTED_FINALIZATION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS
RV NO_ELABORATION_CODE

U gps.lsp_client.callbacks%b  gps-lsp_client-callbacks.adb  38e1d209 OO PK IU
Z ada.exceptions%s	a-except.adb		a-except.ali
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
Z ada.tags%s		a-tags.adb		a-tags.ali
W gps%s			gps.ads			gps.ali
W gps.lsp_client%s	gps-lsp_client.ads	gps-lsp_client.ali
W gps.lsp_client.language_servers%s  gps-lsp_client-language_servers.adb  gps-lsp_client-language_servers.ali
W gps.lsp_client.utilities%s  gps-lsp_client-utilities.adb  gps-lsp_client-utilities.ali
Z system%s		system.ads		system.ali
Z system.finalization_primitives%s  s-finpri.adb  s-finpri.ali
Z system.return_stack%s	s-retsta.ads		s-retsta.ali
Z system.soft_links%s	s-soflin.adb		s-soflin.ali
Z system.standard_library%s  s-stalib.adb	s-stalib.ali
W vss%s			vss.ads			vss.ali
W vss.strings%s		vss-strings.adb		vss-strings.ali

U gps.lsp_client.callbacks%s  gps-lsp_client-callbacks.ads  981f1750 EE OO PF PK IU
Z ada.exceptions%s	a-except.adb		a-except.ali
Z ada.streams%s		a-stream.adb		a-stream.ali
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
Z ada.tags%s		a-tags.adb		a-tags.ali
W gnatcoll%s		gnatcoll.ads		gnatcoll.ali
W gnatcoll.vfs%s	gnatcoll-vfs.adb	gnatcoll-vfs.ali
W gps.lsp_client%s	gps-lsp_client.ads	gps-lsp_client.ali
Y gps.lsp_client.language_servers%s  gps-lsp_client-language_servers.adb  gps-lsp_client-language_servers.ali
W language%s		language.adb		language.ali
W lsp%s			lsp.ads			lsp.ali
W lsp.messages%s	lsp-messages.adb	lsp-messages.ali
W spawn%s		spawn.ads		spawn.ali
W spawn.environments%s	spawn-environments.adb	spawn-environments.ali
Z system%s		system.ads		system.ali
Z system.finalization_primitives%s  s-finpri.adb  s-finpri.ali
Z system.pool_global%s	s-pooglo.adb		s-pooglo.ali
Z system.return_stack%s	s-retsta.ads		s-retsta.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali
Z system.soft_links%s	s-soflin.adb		s-soflin.ali
Z system.storage_pools%s  s-stopoo.adb		s-stopoo.ali
Z system.tasking%s	s-taskin.adb		s-taskin.ali

